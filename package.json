{
  "name": "glisp",
  "version": "0.0.0",
  "private": true,
  "description": "Glisp language and its hosts",
  "type": "module",
  "workspaces": [
    "packages/*",
    "site",
    "dev_modules/tweeq"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w site",
    "repl": "npm run start -w @glisp/repl",
    "dev": "npm run dev -w site",
    "build": "npm run build -w site"
  },
  "license": "MIT",
  "author": "Baku Hashimoto <mail@baku89.com>",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
