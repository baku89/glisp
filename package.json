{
  "name": "glisp",
  "version": "0.0.0",
  "description": "Glisp language core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "concurrently --names test,doc,api --prefix-colors auto npm:dev:test npm:dev:doc npm:dev:api",
    "dev:test": "vitest",
    "dev:doc": "vuepress dev docs",
    "dev:api": "typedoc --watch",
    "build": "tsc",
    "build:api": "typedoc",
    "build:doc": "npm run build:api && vuepress build docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "repl": "tsx src/repl.ts"
  },
  "license": "MIT",
  "author": "Baku Hashimoto <mail@baku89.com>",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vuepress/bundler-vite": "^2.0.0-rc.26",
    "@vuepress/plugin-shiki": "^2.0.0-rc.123",
    "@vuepress/theme-default": "^2.0.0-rc.123",
    "concurrently": "^9.2.1",
    "markdown-it-cjk-friendly": "^2.0.2",
    "picocolors": "^1.1.1",
    "sass-embedded": "^1.86.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.1",
    "typedoc-plugin-markdown": "^4.6.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vuepress": "^2.0.0-rc.26"
  }
}
