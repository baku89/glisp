{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "tweeq": [
        "../../dev_modules/tweeq/src"
      ],
      "tweeq/*": [
        "../../dev_modules/tweeq/src/*"
      ]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "./modules.d.ts",
    ".vuepress/**/*.ts",
    ".vuepress/**/*.vue"
  ]
}
